# Copy to .env and fill in real values before deploying:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=ConexyAI
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Backend secrets ---
# JWT signing key: at least 32 bytes of random data.
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_ISSUER=https://conexyai.ru
JWT_AUDIENCE=https://conexyai.ru

# --- DeepSeek upstream ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_AGENT_MODEL=deepseek-v4-pro

# --- GitHub PAT (optional, enables the github_action tool) ---
GITHUB_PAT=

# --- GitHub OAuth (login) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Web search (optional) ---
JSONSEO_API_KEY=
JSONSEO_ENDPOINT=https://jsonseo.ru/api/yandex

# --- Yandex SpeechKit (optional, enables voice) ---
SPEECHKIT_API_KEY=
SPEECHKIT_FOLDER_ID=

# --- Sandbox ---
# Must match the image built from docker/sandbox/Dockerfile and present on the Docker host.
SANDBOX_IMAGE=conexy-sandbox:latest

# --- Host paths ---
# Must exist on the Docker host and be writable by the backend's non-root user (uid 1654).
# The source and target paths MUST be identical so `docker run -v <host>:/workspace` sent
# through the socket proxy resolves to the same directory the backend writes to. See DEPLOY.md.
WORKSPACE_HOST_PATH=/srv/conexyai/workspaces
RAG_DOCUMENTS_PATH=/srv/conexyai/documents

# --- Frontend ---
HTTP_PORT=80
