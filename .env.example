# Copy to .env and fill in real values before deploying:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=ConexyAI
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Backend secrets ---
# JWT signing key: at least 32 bytes of random data. REQUIRED — deliberately left empty here.
# Generate with: openssl rand -base64 48
# Outside Development the backend refuses to start when the key is missing, shorter than
# 32 bytes, or still a placeholder (anyone knowing it could mint admin tokens).
JWT_SIGNING_KEY=
JWT_ISSUER=https://conexyai.ru
JWT_AUDIENCE=https://conexyai.ru

# --- DeepSeek upstream ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_AGENT_MODEL=deepseek-v4-pro

# --- GitHub PAT (optional, enables the github_action tool) ---
GITHUB_PAT=

# --- GitHub OAuth (login) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Admin accounts (comma-separated) ---
# Entries: GitHub usernames, github-id:<numeric GitHub id> (most robust), or emails. An email only
# counts when GitHub reports it verified for the account logging in; registering it with a password
# never grants admin.
ADMIN_ACCOUNTS=

# --- Web search (optional) ---
JSONSEO_API_KEY=
JSONSEO_ENDPOINT=https://jsonseo.ru/api/yandex

# --- Yandex SpeechKit (optional, enables voice) ---
SPEECHKIT_API_KEY=
SPEECHKIT_FOLDER_ID=

# --- Sandbox ---
# Must match the image built from docker/sandbox/Dockerfile and present on the Docker host.
SANDBOX_IMAGE=conexy-sandbox:latest

# --- Host paths ---
# Must exist on the Docker host and be writable by the backend's non-root user (uid 1654).
# The source and target paths MUST be identical so `docker run -v <host>:/workspace` sent
# through the socket proxy resolves to the same directory the backend writes to. See DEPLOY.md.
WORKSPACE_HOST_PATH=/srv/conexyai/workspaces
RAG_DOCUMENTS_PATH=/srv/conexyai/documents

# --- Frontend ---
HTTP_PORT=80


# LEGAL_DOCS: реквизиты оператора для публичных правовых документов (политика обработки
# персональных данных, публичная оферта, политика возврата). Это ПЕРСОНАЛЬНЫЕ ДАННЫЕ: держите их
# только здесь, в этом файле на сервере (.env в .gitignore), и не переносите в репозиторий.
# Значения отдаются сайту через GET /api/legal/operator, фронт их не хранит.
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
# Даты в свободной форме, обычно ISO: 2026-10-01
OPERATOR_PUBLISHED_AT=
OPERATOR_UPDATED_AT=
# Государства, куда уходят тексты запросов к моделям ИИ (раздел 8 политики ПДн).
OPERATOR_TRANSFER_COUNTRIES=
OPERATOR_SITE=conexyai.ru


# SESSION_LIFETIME: срок жизни сессии в минутах (129600 = 90 дней). Значение по умолчанию уже
# такое, переменная нужна только чтобы поменять его без правки кода. После изменения — пересоздать
# backend. Маленькое значение = пользователей будет разлогинивать посреди работы.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=129600

# --- YooKassa (payments) ---
# shopId и секретный ключ ОДОБРЕННОГО магазина ЮKassa. Секрет держите только здесь, в .env на
# сервере: без них кнопки покупки тарифов отвечают ошибкой 503.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Подсети ЮKassa, с которых приходят вебхуки (CIDR, через запятую). Пусто = проверка источника
# по IP ОТКЛЮЧЕНА (платёж всё равно подтверждается через API ЮKassa). Актуальный список берите
# в документации ЮKassa и при изменении правьте здесь, не в коде.
YOOKASSA_NOTIFICATION_IPS=
# Куда вернуть пользователя после оплаты — адрес сайта (SPA покажет окно статуса платежа).
YOOKASSA_RETURN_URL=https://conexyai.ru/
