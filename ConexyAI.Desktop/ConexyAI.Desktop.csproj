<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>conexy</AssemblyName>
        <RootNamespace>ConexyAI.Desktop</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.12" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.12" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.12" />
    </ItemGroup>

</Project>
