<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>conexy</AssemblyName>
        <RootNamespace>ConexyAI.Desktop</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <Version>0.9.1</Version>
        <ApplicationIcon>conexy.ico</ApplicationIcon>
        <Company>ConexyAI</Company>
        <Product>ConexyAI Desktop</Product>
        <Description>ConexyAI Desktop — AI-агент для кода в терминале</Description>
        <Copyright>ConexyAI</Copyright>
        <FileVersion>$(Version).0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MailKit" Version="4.18.1" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.12" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.12" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.12" />
    </ItemGroup>

</Project>
